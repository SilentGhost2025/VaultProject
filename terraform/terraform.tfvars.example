################################################################################
# Witty Tale Vault - Terraform Variable Values
# Copy this to terraform.tfvars and fill in your actual values
# NEVER commit terraform.tfvars to Git — it's in .gitignore
################################################################################

aws_region   = "us-east-1"
project_name = "witty-tale-vault"
environment  = "prod"

# ── Network ───────────────────────────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# ── Security ──────────────────────────────────────────────────────────────────
# Replace with YOUR actual public IP: curl ifconfig.me
your_ip_cidr = "102.89.68.222/32"

# Name of your EC2 key pair in AWS (create in EC2 > Key Pairs if you don't have one)
key_name = "NewKEY"

# ── AMI ───────────────────────────────────────────────────────────────────────
# Ubuntu 22.04 LTS us-east-1 (verify at https://cloud-images.ubuntu.com/locator/ec2/)
ami_id = "ami-0c7217cdde317cfec"

# ── Instance Types ────────────────────────────────────────────────────────────
bastion_instance_type   = "t3.micro"
jenkins_instance_type   = "t3.large"    # Maven builds need CPU/RAM
# sonarqube_instance_type = "t3.medium"   # SonarQube needs 4GB RAM minimum
app_instance_type       = "t3.medium"
